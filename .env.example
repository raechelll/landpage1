# Untuk domain khusus atau hosting di luar Vercel, isi alamat publik sebelum build.
# NEXT_PUBLIC_SITE_URL=https://bukanota.com

# Di Vercel, domain deployment terdeteksi otomatis bila variabel ini tidak diisi.
# Jalankan ulang build/deployment setelah mengubah alamat publik.

# Pengiriman formulir kontak melalui Resend (server only).
# Salin ke .env.local; jangan gunakan NEXT_PUBLIC_ untuk API key.
# Tanpa konfigurasi ini, formulir hanya menampilkan pratinjau demo.
# Restart server setelah mengisi kedua nilai di bawah.
RESEND_API_KEY=
# Alamat pengirim pada domain yang sudah diverifikasi di Resend.
CONTACT_FROM_EMAIL=
# Email penerima demo: bukanota@gmail.com (ditentukan di lib/contact.ts).
